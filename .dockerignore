# Whitelist: exclude everything, then include only what the API needs at runtime
*

!requirements.txt
!*.py
!alembic.ini
!authorization/
!bootstrap/
!db/
!extensions/
!routers/
!static/

# Re-exclude dev/test artifacts and secrets inside whitelisted paths
conftest.py
**/__pycache__/
**/*.pyc
**/.env*
**/.venv*/
**/venv*/
**/test_*
**/tests/
**/*.pem
**/*.key
**/secrets/
**/credentials/
**/configuration.local/
